{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .agents/hooks/check.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/type-check.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/knip.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/jscpd.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/klint.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/secretlint.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/madge.ts"
          },
          {
            "type": "command",
            "command": "bun .agents/hooks/lf.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run check *)",
      "Bash(bun run check-write *)",
      "Bash(bun run type-check *)",
      "Bash(bun run knip *)",
      "Bash(bun test *)",
      "Bash(bun klint/cli.ts *)",
      "Bash(bun run klint *)",
      "Bash(bun eval/run.ts *)"
    ],
    "deny": [
      "Bash(sed -i:*)",
      "Bash(gsed -i:*)",
      "Bash(perl -i:*)",
      "Bash(perl -pi:*)",
      "Bash(perl -ni:*)",
      "Bash(ed:*)",
      "Bash(ex:*)",
      "Bash(patch:*)",
      "Bash(truncate:*)",
      "Bash(dd:*)"
    ]
  }
}
