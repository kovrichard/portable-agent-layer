{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .agents/hooks/gates.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [{ "type": "command", "command": "bun .agents/scripts/agent-isolation.ts" }]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [{ "type": "command", "command": "bun .agents/hooks/gates.ts --subagent" }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "bun .agents/hooks/gates.ts --subagent" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run check *)",
      "Bash(bun run check-write *)",
      "Bash(bun run type-check *)",
      "Bash(bun run knip *)",
      "Bash(bun test *)",
      "Bash(bun klint/cli.ts *)",
      "Bash(bun run klint *)",
      "Bash(bun eval/run.ts *)"
    ],
    "deny": [
      "Bash(sed -i:*)",
      "Bash(gsed -i:*)",
      "Bash(perl -i:*)",
      "Bash(perl -pi:*)",
      "Bash(perl -ni:*)",
      "Bash(ed:*)",
      "Bash(ex:*)",
      "Bash(patch:*)",
      "Bash(truncate:*)",
      "Bash(dd:*)"
    ]
  }
}
