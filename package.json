{
  "name": "portable-agent-layer",
  "version": "0.115.0",
  "description": "PAL — Portable Agent Layer: persistent personal context for AI coding assistants",
  "type": "module",
  "bin": {
    "pal": "src/cli/index.ts"
  },
  "files": [
    "src/",
    "assets/",
    ".claude-plugin/",
    ".husky/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "src/tools/control-room/ui"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "ai",
    "claude",
    "opencode",
    "personal-ai",
    "context",
    "memory",
    "telos",
    "agent",
    "portable",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "antigravity",
    "skills"
  ],
  "license": "MIT",
  "homepage": "https://pal.konvert7.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovrichard/portable-agent-layer.git"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun .agents/scripts/test.ts",
    "test:mutate": "stryker run",
    "test:mutate:diff": "bun .agents/scripts/mutate-diff.ts",
    "format": "biome format",
    "format-write": "biome format --write",
    "lint": "biome lint",
    "lint-write": "biome lint --write",
    "check": "biome check",
    "check-write": "bun .agents/scripts/check-write.ts",
    "knip": "knip-bun",
    "klint": "klint && klint --config test",
    "klint:hook": "klint --json --hook && klint --config test --json --hook",
    "jscpd": "jscpd --no-tips",
    "madge": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "lf": "bun .agents/scripts/check-lf.ts",
    "lf:fix": "bun .agents/scripts/check-lf.ts --fix",
    "exact-versions": "bun .agents/scripts/check-exact-versions.ts",
    "secretlint": "secretlint \"**/*\"",
    "lint-staged": "lint-staged",
    "prepare": "bun .husky/install.mjs",
    "build:ui": "bun run --filter @pal/control-room-ui build",
    "dev:ui": "bun run --filter @pal/control-room-ui dev",
    "prepack": "bun run build:ui",
    "install:all": "bun run src/cli/index.ts cli install",
    "uninstall": "bun run src/cli/index.ts cli uninstall",
    "stamp:factory": "bun run src/tools/dark-factory/stamp.ts",
    "tool:synthesize": "bun run src/tools/agent/synthesize.ts",
    "eval:goal-links": "bun eval/run.ts goal-links",
    "eval:reaction": "bun eval/run.ts reaction",
    "eval:correction-check": "bun eval/run.ts correction-check",
    "eval:po-answer": "bun eval/run.ts po-answer",
    "eval:entity-extraction": "bun eval/entity-extraction/build-prompt.ts && bun eval/run.ts entity-extraction",
    "eval:correction-kind": "bun eval/correction-kind/build-prompt.ts && bun eval/run.ts correction-kind",
    "eval:correction-kind:test": "bun eval/correction-kind/test-set.ts",
    "eval:rule-drafter": "bun eval/rule-drafter/build-prompt.ts && bun eval/run.ts rule-drafter",
    "eval:rule-drafter:test": "bun eval/rule-drafter/test-set.ts"
  },
  "lint-staged": {
    "*.ts": [
      "bun run check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@hughescr/stryker-bun-runner": "1.3.8",
    "@konvert7/klint": "0.36.0",
    "@opencode-ai/plugin": "1.19.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@stryker-mutator/core": "9.6.1",
    "@types/bun": "1.4.4",
    "@types/node": "25.9.1",
    "husky": "9.1.7",
    "issue-parser": "7.0.2",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "madge": "8.0.0",
    "promptfoo": "0.121.14",
    "secretlint": "13.1.0",
    "semantic-release": "25.0.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "adm-zip": "0.6.1",
    "fast-myers-diff": "3.2.0",
    "marked": "18.1.3",
    "pdf-lib": "1.17.1",
    "playwright": "1.64.1",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "playwright-core": "1.60.0"
  }
}
