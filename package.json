{
  "name": "pai",
  "version": "0.1.0",
  "description": "PAI — Personal AI Infrastructure",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format",
    "format-write": "biome format --write",
    "lint": "biome lint",
    "lint-write": "biome lint --write",
    "check": "biome check",
    "check-write": "biome check --write",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "install:all": "bun run install.ts",
    "uninstall": "bun run uninstall.ts",
    "tool:entity-save": "bun run tools/entity-save.ts",
    "tool:fyzz-api": "bun run tools/fyzz-api.ts",
    "tool:pdf-download": "bun run tools/pdf-download.ts",
    "tool:patterns": "bun run tools/pattern-synthesis.ts",
    "tool:reflect": "bun run tools/relationship-reflect.ts",
    "tool:export": "bun run tools/export.ts",
    "tool:import": "bun run tools/import.ts"
  },
  "lint-staged": {
    "*.ts": [
      "bun run check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@opencode-ai/plugin": "latest",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "latest",
    "@types/node": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  }
}
