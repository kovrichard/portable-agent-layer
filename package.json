{
  "name": "portable-agent-layer",
  "version": "0.29.1",
  "description": "PAL — Portable Agent Layer: persistent personal context for AI coding assistants",
  "type": "module",
  "bin": {
    "pal": "src/cli/index.ts"
  },
  "files": [
    "src/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "ai",
    "claude",
    "opencode",
    "personal-ai",
    "context",
    "memory",
    "telos",
    "agent",
    "portable"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovrichard/portable-agent-layer.git"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format",
    "format-write": "biome format --write",
    "lint": "biome lint",
    "lint-write": "biome lint --write",
    "check": "biome check",
    "check-write": "biome check --write",
    "knip": "knip-bun",
    "lint-staged": "lint-staged",
    "prepare": "bun .husky/install.mjs",
    "install:all": "bun run src/cli/index.ts cli install",
    "uninstall": "bun run src/cli/index.ts cli uninstall",
    "tool:synthesize": "bun run src/tools/agent/synthesize.ts",
    "tool:thread": "bun run src/tools/agent/thread.ts",
    "tool:analyze": "bun run src/tools/agent/analyze.ts",
    "tool:wisdom-frame": "bun run src/tools/agent/wisdom-frame.ts",
    "tool:reflect": "bun run src/tools/relationship-reflect.ts",
    "tool:export": "bun run src/tools/export.ts",
    "tool:import": "bun run src/tools/import.ts",
    "tool:tokens": "bun run src/tools/token-cost.ts"
  },
  "lint-staged": {
    "*.ts": [
      "bun run check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@opencode-ai/plugin": "latest",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "latest",
    "@types/node": "latest",
    "husky": "^9.1.7",
    "knip": "^6.9.0",
    "lint-staged": "^15.5.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "adm-zip": "^0.5.16",
    "marked": "^15.0.0",
    "playwright": "^1.49.0"
  }
}
