{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [
        "klint.rules.ts",
        "src/tools/**/*.ts",
        "src/hooks/*.ts",
        "src/hooks/handlers/*.ts",
        "src/targets/**/install.ts",
        "src/targets/**/uninstall.ts",
        ".agents/hooks/*.ts",
        ".agents/scripts/*.ts",
        "assets/skills/*/tools/*.ts",
        ".opencode/plugins/*.ts"
      ],
      "project": ["src/**/*.ts", "!src/tools/control-room/ui/**"],
      "bun": { "entry": ["**/*.{test,spec}.{js,jsx,ts,tsx}"] },
      "ignore": [".opencode/plugins/lint.ts", "src/targets/opencode/plugin.ts"],
      "ignoreDependencies": [
        "@semantic-release/github",
        "@semantic-release/changelog",
        "@semantic-release/git",
        "promptfoo",
        "@stryker-mutator/bun-runner",
        "@stryker-mutator/api",
        "@secretlint/secretlint-rule-preset-recommend"
      ]
    },
    "src/tools/control-room/ui": {
      "project": ["**/*.ts", "**/*.tsx", "!dist/**"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
