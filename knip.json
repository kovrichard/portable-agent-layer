{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/tools/**/*.ts",
    "src/hooks/*.ts",
    "src/hooks/handlers/*.ts",
    "src/targets/**/install.ts",
    "src/targets/**/uninstall.ts",
    ".agents/hooks/*.ts",
    "assets/skills/*/tools/*.ts",
    ".opencode/plugins/*.ts",
    "flint/cli.ts"
  ],
  "project": [
    "src/**/*.ts",
    "flint/**/*.ts"
  ],
  "includeEntryExports": true,
  "tags": ["-lintignore"],
  "ignore": [
    ".opencode/plugins/lint.ts",
    "src/targets/opencode/plugin.ts",
    ".agents/hooks/flint.rules.ts"
  ],
  "ignoreDependencies": [
    "@semantic-release/github"
  ]
}
