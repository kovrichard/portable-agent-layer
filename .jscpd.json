{
  "threshold": 2.5,
  "reporters": ["threshold"],
  "absolute": false,
  "gitignore": true,
  "minLines": 8,
  "minTokens": 70,
  "format": ["typescript", "tsx", "javascript", "json"],
  "ignore": [
    "**/node_modules/**",
    ".test/**",
    "**/dist/**",
    "**/.git/**",
    "assets/skills/presentation/vendor/**",
    "assets/skills/presentation/theme-base/**",
    "test/**",
    ".claude/worktrees",
    ".claude/skills/**",
    ".cursor/skills/**"
  ]
}
