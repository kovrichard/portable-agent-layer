{
  "$schema": "./klint.schema.json",
  "include": ["src", "klint", "assets", "!**/node_modules/**"],
  "plugins": ["sonar"],
  "rules": {
    "no-unguarded-json-parse": "error",
    "no-sync-in-async": { "severity": "error", "include": ["src/hooks/**"] },
    "no-floating-promise": "error",
    "no-misused-promises": "error",
    "no-date-equality": "error",
    "no-optional-chain-on-non-nullable": "error",
    "no-object-in-template": "error",
    "no-nested-template-literals": "error",
    "no-consecutive-array-push": "error",
    "no-string-match": "error",
    "sonar/prefer-string-raw": "off"
  },
  "customRules": [
    "no-console-in-hook-lib",
    "no-raw-anthropic-fetch",
    "no-raw-api-key-access",
    "no-agent-import-in-core",
    "no-hardcoded-pal-home",
    "no-raw-exit-in-lib"
  ]
}
