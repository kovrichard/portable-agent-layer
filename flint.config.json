{
  "include": ["src"],
  "rules": [
    "no-unguarded-json-parse",
    { "rule": "no-sync-in-async", "include": ["src/hooks/**"] },
    "no-floating-promise",
    "no-misused-promises"
  ],
  "customRules": [
    "no-console-in-hook-lib",
    "no-raw-anthropic-fetch",
    "no-raw-api-key-access",
    "no-agent-import-in-core",
    "no-hardcoded-pal-home",
    "no-raw-exit-in-lib"
  ]
}
