{
  "permissions": {
    "allow": [
      "Read(//*)",
      "WebFetch",
      "WebSearch",
      "Bash(cat //*)",
      "Bash(head //*)",
      "Bash(tail //*)",
      "Bash(ls //*)",
      "Bash(find //*)",
      "Bash(grep *)",
      "Bash(rg //*)",
      "Bash(wc *)",
      "Bash(diff //*)",
      "Bash(which //*)",
      "Bash(file //*)",
      "Bash(stat //*)",
      "Bash(readlink //*)",
      "Bash(lsof *)",
      "Bash(bun ~/.pal/skills/*/tools/*.ts *)",
      "Bash(bun ~/.pal/tools/*.ts *)",
      "Bash(node --experimental-strip-types ~/.pal/skills/consulting-report/tools/generate-pdf.ts *)"
    ]
  },
  "skillOverrides": {
    "claude-api": "off",
    "update-config": "off",
    "deep-research": "off",
    "code-review": "off"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "showClearContextOnPlanAccept": true,
  "respectGitignore": true,
  "spinnerTipsEnabled": true,
  "spinnerTipsOverride": {
    "tips": [
      "Need something reusable? Use the /create-skill command.",
      "PAL learns from your feedback and improves over time. Don't be shy to give feedback!",
      "For simple PDFs use the /create-pdf skill. Need a styled one? Use /consulting-report instead.",
      "Use the /research skill to run comprehensive web research with multiple parallel agents.",
      "Create presentations in HTML using the /presentation skill.",
      "PAL can \"see\" what you are doing in the browser with the /playwright skill.",
      "Want PAL to watch a youtube video? There's /analyze-youtube for that."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/LoadContext.ts"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/CompactRecover.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/PreCompactPersist.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/UserPromptOrchestrator.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/SecurityValidator.ts"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/SkillGuard.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/RtkWrap.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "PAL_AGENT=claude bun run {{PKG_ROOT}}/src/hooks/StopOrchestrator.ts"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
